# Environment template — copy to .env and fill with YOUR values.
# Real keys are NEVER committed. See README.md → Security.

# OpenRouter (LLM API)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx

# ElevenLabs (text-to-speech)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxx
ELEVENLABS_PROXY=http://your-proxy:port
ELEVENLABS_VOICE=21m00Tcm4TlvDq8ikWAM

# Telegram bots — one token per agent (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_HOME_CHANNEL=123456789

# Ollama (local models)
OLLAMA_BASE_URL=http://127.0.0.1:11434
